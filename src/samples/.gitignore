*.pdf

# mdm:sections-glob - symlinks 'mdm sync' creates into the assets/ tree, regenerated
# on every sync. Kept in sync with 'mdm/paths.yaml' by 'mdm paths set sections'.
sections/**/*.assets
sections/**/assets

# mdm:output-path - the combined document 'mdm build' produces. It's rebuilt and
# committed by CI, not by hand; kept in sync with 'mdm/paths.yaml' by 'mdm paths set output'.
document.md
