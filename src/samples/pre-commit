#!/bin/sh
# Blocks committing changes to the combined output file by hand. It's
# generated by 'mdm build' and rebuilt/committed by CI on every push to a
# protected branch; a manual commit to it gets overwritten (and reintroduces
# drift in the meantime).
#
# Enable this hook once per clone with:
#   git config core.hooksPath .githooks

# mdm:output-path (regenerated by 'mdm paths set output')
OUTPUT_FILE="document.md"

if git diff --cached --name-only | grep -qx "$OUTPUT_FILE"; then
    echo "error: '$OUTPUT_FILE' is generated by 'mdm build' and committed by CI; it shouldn't be committed by hand." >&2
    echo "Unstage it with: git restore --staged $OUTPUT_FILE" >&2
    exit 1
fi
